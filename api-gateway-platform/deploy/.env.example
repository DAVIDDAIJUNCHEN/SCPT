# ============ AlloMax 商业网关环境变量 ============
# 复制为 .env 并修改所有密码/密钥！
# cp .env.example .env && chmod 600 .env

# --- 存储（大王 VPS 数据盘挂载点）---
DATA_DIR=/data/allomax

# --- 数据库 ---
POSTGRES_USER=allomax
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_1
POSTGRES_DB=allomax

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_2

# --- 会话密钥（务必改为随机长字符串，openssl rand -hex 32）---
SESSION_SECRET=CHANGE_ME_RANDOM_HEX_64

# --- 短信（M1 后置接入；上线前从 mock 切换）---
SMS_PROVIDER=mock
# mock 通道是否在 API 响应回显验证码（开发/教学用；生产必须 false）
SMS_MOCK_RETURN_CODE=true
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# --- ClickHouse（可选，日志量大后启用）---
# CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_3
