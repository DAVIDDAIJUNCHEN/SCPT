# ===== 川邮·星语 部署源 .gitignore =====
# 敏感/运行时/构建产物不入库（VPS 部署基线用）

# 敏感配置
.env
*.env
!.env.example

# AppleDouble (Mac scp 元数据垃圾)
._*
.DS_Store

# 运行时数据
data/
*.db
*.db-wal
*.db-shm
logs/
*.log

# 构建产物
web/node_modules/
web/dist/
web/.vite/
dist/
bin/

# Go
*.test
*.out

# 编辑器
.idea/
.vscode/
*.swp

# 部署临时
deploy/*.tar*
*.sql.gz
backups/
